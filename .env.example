# Ключи провайдеров. Нужен только тот, чьи модели используешь.
# Что готово к работе — покажет: python -m harness models

OPENAI_API_KEY=sk-proj-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIza...
GROQ_API_KEY=gsk_...
DEEPSEEK_API_KEY=sk-...
OPENROUTER_API_KEY=sk-or-...
CEREBRAS_API_KEY=csk-...
MISTRAL_API_KEY=...
AI_GATEWAY_API_KEY=...
AZURE_OPENAI_API_KEY=...
AZURE_OPENAI_ENDPOINT=https://...
BROWSER_USE_API_KEY=bu_...

# Локальные модели ключа не требуют:
#   ollama:qwen3:8b                 (адрес в OLLAMA_HOST, по умолчанию localhost:11434)
#   compat:любая-модель             (адрес в COMPAT_BASE_URL — vLLM, LM Studio, together)
# OLLAMA_HOST=http://127.0.0.1:11434
# COMPAT_BASE_URL=http://127.0.0.1:8000/v1

# Порт локального сервера фикстур; по умолчанию первый свободный с 8777
# HARNESS_FIXTURE_PORT=8777

# Апстрим шлёт анонимную телеметрию; харнесс выключает её по умолчанию.
# ANONYMIZED_TELEMETRY=true
